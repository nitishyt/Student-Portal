# Production environment variables
# Copy this to a .env file on your production server and fill in with actual values

NODE_ENV=production
PORT=5000

# MongoDB Configuration - Use your production MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=YourApp

# JWT Secrets - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-production-access-secret-here-must-be-at-least-64-chars
JWT_REFRESH_SECRET=your-production-refresh-secret-here-must-be-at-least-64-chars

# Frontend URL for CORS (exact origin, no trailing slash)
FRONTEND_URL=https://your-frontend-domain.com
