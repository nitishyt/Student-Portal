# ────────────────────────────────────────────────
# Backend Environment Variables (NEVER commit .env)
# ────────────────────────────────────────────────

# MongoDB connection string (Atlas or local)
# Local:  mongodb://localhost:27017/student_portal
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/student_portal
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/student_portal?retryWrites=true&w=majority

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_secure_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_at_least_64_chars

# Server port (default: 5000 locally, Render sets PORT automatically)
PORT=5000

# Frontend URL for CORS
# Local:      http://localhost:5173
# Production: https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:5173
