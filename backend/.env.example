# ────────────────────────────────────────────────
# Backend Environment Variables (NEVER commit this)
# ────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/student_portal?retryWrites=true&w=majority

# JWT secret — use a long, random string (e.g. `openssl rand -hex 64`)
JWT_SECRET=change_me_to_a_secure_random_string

# Port (Render sets this automatically)
PORT=10000

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=https://your-frontend.onrender.com
